{
  "python": "3.13.12",
  "dependencies": {
    "gymnasium": "1.4.0",
    "numpy": "2.5.5",
    "cloudpickle": "3.1.3",
    "typing_extensions": "4.16.0",
    "farama-notifications": "0.0.6"
  },
  "environment": "FrozenLake-v1",
  "map_name": "4x4",
  "map": [
    "SFFF",
    "FHFH",
    "FFFH",
    "HFFG"
  ],
  "reward_and_slip_parameters": "defaults, not overridden",
  "batch_seeds": [
    11,
    22,
    33
  ],
  "episodes_per_batch": 50,
  "max_steps": 100,
  "episode_seed_rule": "1000 * batch_seed + i, i=0..49",
  "random_actions": "numpy.random.default_rng(episode_seed).integers(4)",
  "fixed_policy": {
    "0": "down",
    "1": "left",
    "2": "left",
    "3": "left",
    "4": "down",
    "6": "down",
    "8": "right",
    "9": "down",
    "10": "down",
    "13": "right",
    "14": "right"
  },
  "checks": "600 rows; 12 batches; paired seeds; steps/rewards/outcomes; all 150 deterministic fixed episodes reach goal in 6 steps: passed"
}
